AGENT_MEMORY_ENVIRONMENT=development
AGENT_MEMORY_DATABASE__URI=postgresql+psycopg://agent_memory_app:change-me@localhost:5432/agent_memory
AGENT_MEMORY_DATABASE__SCHEMA=agent_memory
AGENT_MEMORY_TENANT__ISOLATION=strict
AGENT_MEMORY_TENANT__POSTGRES_RLS=true
AGENT_MEMORY_CONSENT__DEFAULT=deny
AGENT_MEMORY_EXTRACTION__PROVIDER=rules
AGENT_MEMORY_EXTRACTION__MINIMUM_CONFIDENCE=0.85
AGENT_MEMORY_EXTRACTION__REQUIRE_EVIDENCE=true
AGENT_MEMORY_EXTRACTION__ALLOW_INFERENCE=false
AGENT_MEMORY_EMBEDDINGS__PROVIDER=deterministic
AGENT_MEMORY_EMBEDDINGS__DIMENSIONS=128
AGENT_MEMORY_RETRIEVAL__STRATEGY=hybrid
AGENT_MEMORY_RETRIEVAL__TOP_K=8
AGENT_MEMORY_RETRIEVAL__MINIMUM_SCORE=0.65
AGENT_MEMORY_RETRIEVAL__TOKEN_BUDGET=1200
AGENT_MEMORY_ENCRYPTION__PROVIDER=noop
AGENT_MEMORY_ENCRYPTION__KEY=
